{% extends "base.htm.j2" %}
{% block title %}Spreading Thankfulness in Open Source{% endblock %}
{% block content %}
  <style>
    /* Branded "Sign in with Mastodon" button */
    a.btn-mastodon,
    a.btn-mastodon:link,
    a.btn-mastodon:visited {
      display: inline-flex;
      align-items: stretch;
      height: 46px;
      padding: 0;
      margin: 0;
      overflow: hidden;
      border: 0;
      border-radius: 4px;
      background: #6364ff;
      color: #fff;
      font-family: Arial, Helvetica, sans-serif;
      font-size: 15px;
      font-weight: 600;
      line-height: 46px;
      letter-spacing: 0;
      text-transform: none;
      text-decoration: none;
      box-shadow: 0 1px 2px rgba(0, 0, 0, 0.25);
      transition: background 0.15s ease;
    }

    a.btn-mastodon:hover,
    a.btn-mastodon:focus {
      background: #563acc;
      color: #fff;
      text-decoration: none;
    }

    a.btn-mastodon:focus-visible {
      outline: 3px solid #bcbcff;
      outline-offset: 2px;
    }

    a.btn-mastodon .btn-mastodon-icon {
      display: flex;
      align-items: center;
      justify-content: center;
      width: 46px;
      background: rgba(0, 0, 0, 0.18);
    }

    a.btn-mastodon .btn-mastodon-icon svg {
      width: 24px;
      height: 24px;
      fill: #fff;
    }

    a.btn-mastodon .btn-mastodon-label {
      padding: 0 22px 0 16px;
      white-space: nowrap;
    }

    .mastodon-login-row {
      margin-top: 20px;
    }

    .mastodon-login-row p {
      margin-bottom: 8px;
    }
  </style>

  <p class="home-ad">
    <script async
            type="text/javascript"
            src="//cdn.carbonads.com/carbon.js?serve=CESI52Q7&placement=saythanksio"
            id="_carbonads_js"></script>
  </p>
  <hr>
  <h2>Spreading Thankfulness in Open Source&trade;</h2>
  {% if auth_error %}
    <p role="alert">{{ auth_error }}</p>
  {% endif %}
  <p>
    <strong>SayThanks.io</strong> provides a handy URL for you to share
    with your open source projects&mdash; it encourages users to send a simple
    thank you note to you, the creator of that project.
  </p>
  <p>This simple link can be added to READMEs and project documentation.</p>
  <p>
    Then, you can enjoy a nice inbox of very small but thoughtful messages
    from the happy users of the software that you've toiled over. :)
  </p>
  <hr>
  <div class="row">
    <p class="home-inbox-image-wrap">
      <img class="home-inbox-image"
           src="{{ url_for('static', filename='images/inbox.png') }}"
           alt="Thankfulness Inbox of Love">
    </p>
    <div class="twelve columns u-textcenter">
      <h3>Register Your Inbox of Thankfulness</h3>
      <p>
        Create an account to receive emails when users of your open source
        project say thanks!
      </p>
      {# GitHub Auth button #}
      <script src="https://cdn.auth0.com/js/lock/11.33/lock.min.js"></script>
      <script>
        var options_signup = {
          theme: {
            logo: '{{ url_for('static', filename='images/owly.svg') }}',
            primaryColor: '#3ac025'
          },
          allowSignUp: true,
          allowLogin: false,
          auth: {
            redirectUrl: '{{ callback_url }}',
            params: {
              scope: 'openid email name picture'
            }
          }
        };

        var options_signin = {
          theme: {
            logo: '{{ url_for('static', filename='images/owly.svg') }}',
            primaryColor: '#3ac025'
          },
          allowSignUp: false,
          allowLogin: true,
          auth: {
            redirectUrl: '{{ callback_url }}',
            params: {
              scope: 'openid email name picture'
            }
          }
        };

        var lock1 = new Auth0Lock('{{ auth_id }}', '{{ auth_domain }}', options_signup);
        var lock2 = new Auth0Lock('{{ auth_id }}', '{{ auth_domain }}', options_signin);
      </script>

      <button class="button button-primary" type="button" onClick="lock1.show();">
        Create Your Thankfulness Inbox
      </button>

      <span>or...</span>

      <button class="button" type="button" onClick="lock2.show();">
        Access Your Thankfulness Inbox
      </button>

      {# Mastodon Auth button #}
      <div class="mastodon-login-row">
        <p>Prefer the fediverse?</p>
        <a class="btn-mastodon" href="{{ url_for('mastodon_login') }}">
          <span class="btn-mastodon-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" focusable="false">
              <path d="M23.268 5.313c-.35-2.578-2.617-4.61-5.304-5.004C17.51.242 15.792 0 11.813 0h-.03c-3.98 0-4.835.242-5.288.309C3.882.692 1.496 2.518.917 5.127.64 6.412.61 7.837.661 9.143c.074 1.874.088 3.745.26 5.611.118 1.24.325 2.47.62 3.68.55 2.237 2.777 4.098 4.96 4.857 2.336.792 4.849.923 7.256.38.265-.061.527-.132.786-.213.585-.184 1.27-.39 1.774-.753a.057.057 0 0 0 .023-.043v-1.809a.052.052 0 0 0-.02-.041.053.053 0 0 0-.046-.01 20.282 20.282 0 0 1-4.709.545c-2.73 0-3.463-1.284-3.674-1.818a5.593 5.593 0 0 1-.319-1.433.053.053 0 0 1 .066-.054c1.517.363 3.072.546 4.632.546.376 0 .75 0 1.125-.01 1.57-.044 3.224-.124 4.768-.422.038-.008.077-.015.11-.024 2.435-.464 4.753-1.92 4.989-5.604.008-.145.03-1.52.03-1.67.002-.512.167-3.63-.024-5.545zm-3.748 9.195h-2.561V8.29c0-1.309-.55-1.976-1.67-1.976-1.23 0-1.846.79-1.846 2.35v3.403h-2.546V8.663c0-1.56-.617-2.35-1.848-2.35-1.112 0-1.668.668-1.67 1.977v6.218H4.822V8.102c0-1.31.337-2.35 1.011-3.12.696-.77 1.608-1.164 2.74-1.164 1.311 0 2.302.5 2.962 1.498l.638 1.06.638-1.06c.66-.999 1.65-1.498 2.96-1.498 1.13 0 2.043.395 2.74 1.164.675.77 1.012 1.81 1.012 3.12z"/>
            </svg>
          </span>
          <span class="btn-mastodon-label">Sign in with Mastodon</span>
        </a>
      </div>
    </div>
  </div>
  <hr>
  <p>
    This is an open source project, and its code is being actively
    developed in the open
    <a href="https://github.com/BlitzKraft/saythanks.io">on GitHub</a>
    .
    <br>
    Oh, and if you like this project, try
    <a href="https://saythanks.io/to/lifebalance&saythanks">saying thanks</a>
    to its maintainer!
  </p>
{% endblock %}